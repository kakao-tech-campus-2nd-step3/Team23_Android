<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/all_layout_padding"
    tools:context=".SendCompleteActivity">
    <TextView
        android:id="@+id/send_complete_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="@string/send_complete_message"
        android:textSize="@dimen/send_complete_text_size"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/all_background_button"
        android:padding="15dp"
        />
    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/congratulations"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/time_progress_indicator"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/send_complete_textview"
        app:layout_constraintBottom_toBottomOf="parent"
        android:max="100"
        android:progress="100"
        app:indicatorColor="@color/blue500"
        app:trackColor="@color/background_base"
        app:trackThickness="5dp"
        />
    <TextView
        android:id="@+id/time_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/time_progress_indicator"
        app:layout_constraintBottom_toBottomOf="@id/time_progress_indicator"
        app:layout_constraintStart_toStartOf="@id/time_progress_indicator"
        app:layout_constraintEnd_toEndOf="@id/time_progress_indicator"
        android:textSize="24sp"
        android:textColor="@color/black"
        />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/close_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/all_close"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/time_progress_indicator"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
